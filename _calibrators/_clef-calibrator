<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>QuizNote — Clef Tile Calibrator</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="https://cdn.jsdelivr.net/gh/steinbergmedia/bravura@master/redist/woff/BravuraText.woff2" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="qn-theme.css">
<style>
  @font-face {
    font-family: 'Bravura Text';
    font-style: normal;
    font-weight: 400;
    font-display: block;
    src: url('https://cdn.jsdelivr.net/gh/steinbergmedia/bravura@master/redist/woff/BravuraText.woff2') format('woff2');
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 24px;
    background: var(--cream, #fffbe9);
    color: var(--ink, #2A2A3E);
    font-family: 'Nunito', system-ui, sans-serif;
    line-height: 1.4;
  }
  h1 { font-family: 'Fredoka', sans-serif; font-size: 28px; margin: 0 0 8px; }
  h2 { font-family: 'Fredoka', sans-serif; font-size: 20px; margin: 32px 0 12px; border-bottom: 2px solid #2A2A3E; padding-bottom: 4px; }
  h3 { font-family: 'Fredoka', sans-serif; font-size: 16px; margin: 16px 0 8px; color: #5a5a6e; }
  .intro { font-size: 14px; color: #5a5a6e; max-width: 800px; }

  /* Bravura load indicator */
  .bravura-check {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 8px;
    font-family: 'Bravura Text', monospace;
    font-size: 28px;
    background: white;
    border: 2px solid #2A2A3E;
    margin-left: 12px;
    vertical-align: middle;
  }
  .bravura-check::before { content: '\E050  \E062'; }

  /* Variant comparison grid */
  .variant-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 16px;
  }
  .variant-card {
    background: white;
    border: 2px solid #2A2A3E;
    border-radius: 12px;
    padding: 14px;
  }
  .variant-card h4 {
    font-family: 'Fredoka', sans-serif;
    margin: 0 0 8px;
    font-size: 15px;
    display: flex; justify-content: space-between; align-items: center;
  }
  .variant-card h4 .badge {
    background: #5B3FE4; color: white;
    border-radius: 999px;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 600;
  }
  .variant-card .renders {
    display: flex; align-items: end; gap: 16px;
    background: #fff8e6;
    border-radius: 8px;
    padding: 12px;
    justify-content: center;
    min-height: 180px;
  }
  .variant-card .render-block {
    text-align: center;
  }
  .variant-card .render-block .label {
    font-size: 11px; color: #5a5a6e; margin-top: 4px;
    font-family: 'Fredoka', sans-serif; font-weight: 600;
  }
  .variant-card svg.tile-clef { display: block; }
  .variant-card .modules-list {
    font-size: 12px; color: #5a5a6e; margin-top: 10px;
    line-height: 1.5;
  }
  .variant-card .params {
    font-family: 'Courier New', monospace;
    font-size: 11px;
    background: #f3f0ff;
    padding: 8px;
    border-radius: 6px;
    margin-top: 8px;
    white-space: pre-wrap;
    word-break: break-all;
  }

  /* Editor */
  .editor {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 24px;
    background: white;
    border: 2px solid #2A2A3E;
    border-radius: 12px;
    padding: 20px;
  }
  .preview-pane {
    display: flex; flex-direction: column; gap: 18px;
    align-items: center;
    justify-content: flex-start;
  }
  .preview-pane .preview-row {
    display: flex; gap: 20px; align-items: end;
    background: #fff8e6;
    padding: 18px;
    border-radius: 10px;
    width: 100%;
    justify-content: center;
  }
  .preview-block { text-align: center; }
  .preview-block .label {
    font-size: 13px; color: #5a5a6e; margin-top: 6px;
    font-family: 'Fredoka', sans-serif; font-weight: 600;
  }
  .actual-size-note {
    font-size: 12px; color: #5a5a6e; margin-top: 4px;
  }

  .controls {
    display: flex; flex-direction: column;
    gap: 4px;
    max-height: 720px;
    overflow-y: auto;
    padding-right: 8px;
  }
  .controls fieldset {
    border: 1px solid #d4cfe8;
    border-radius: 8px;
    padding: 8px 10px 10px;
    margin: 4px 0;
  }
  .controls legend {
    font-family: 'Fredoka', sans-serif;
    font-weight: 600;
    padding: 0 6px;
    color: #5B3FE4;
    font-size: 13px;
  }
  .control-row {
    display: grid;
    grid-template-columns: 100px 1fr 56px;
    gap: 6px; align-items: center;
    font-size: 12px;
    margin: 4px 0;
  }
  .control-row label {
    font-weight: 600; color: #5a5a6e;
  }
  .control-row input[type=range] {
    width: 100%;
  }
  .control-row input[type=number] {
    width: 100%;
    font-family: 'Courier New', monospace;
    font-size: 12px;
    padding: 3px 4px;
    border: 1px solid #d4cfe8;
    border-radius: 4px;
  }

  .preset-row {
    display: flex; gap: 8px; flex-wrap: wrap; margin: 10px 0;
  }
  .preset-row button {
    font-family: 'Fredoka', sans-serif;
    font-size: 12px;
    background: white;
    border: 2px solid #2A2A3E;
    border-radius: 8px;
    padding: 6px 12px;
    cursor: pointer;
    font-weight: 600;
  }
  .preset-row button:hover { background: #fffbe9; }

  /* Output */
  .output-card {
    background: #2A2A3E;
    color: #d4d4d4;
    border-radius: 12px;
    padding: 16px;
    font-family: 'Courier New', monospace;
    font-size: 12px;
    line-height: 1.5;
    margin-top: 20px;
    overflow-x: auto;
    white-space: pre;
  }
  .output-card .key { color: #FFB627; }
  .output-card .val { color: #1FB8A8; }
  .output-card .str { color: #FF8FB1; }

  .copy-btn {
    background: #5B3FE4; color: white;
    border: none; border-radius: 8px;
    padding: 8px 16px;
    font-family: 'Fredoka', sans-serif; font-weight: 600;
    cursor: pointer;
    font-size: 13px;
    margin-bottom: 10px;
  }
  .copy-btn.copied { background: #1FB8A8; }
</style>
</head>
<body>

<h1>QuizNote — Clef Tile Calibrator
  <span class="bravura-check" title="If you see two clef shapes here, Bravura is loaded. If you see squares, it hasn't loaded yet."></span>
</h1>
<p class="intro">
  14 modules have treble / bass / both clef-picker tiles. Today, they fall into 3 distinct visual variants
  for each clef (the top section shows them at actual size and 2× scale). The bottom section is a live
  editor — adjust the sliders until the canonical tile looks right; the values + a copy-paste-ready
  snippet appear at the bottom. Once locked, those numbers go into <code>qn-ui.js</code> (or a similar
  shared helper) and every clef-picker module pulls from that single source.
</p>

<h2>1 · Current variants in the wild</h2>

<div id="current-variants"></div>

<h2>2 · Canonical target (live editor)</h2>

<div class="preset-row">
  <strong style="font-family:Fredoka,sans-serif;font-size:13px;padding:6px 4px;">Load preset:</strong>
  <button onclick="loadPreset('clean')">Clean Bravura (defaults)</button>
  <button onclick="loadPreset('v1')">Match variant 1 (serif, 7 modules)</button>
  <button onclick="loadPreset('v2')">Match variant 2 (Bravura, 5 modules)</button>
  <button onclick="loadPreset('v3')">Match variant 3 (Bravura, 2 modules)</button>
</div>

<div class="editor">
  <div class="preview-pane">
    <div class="preview-row">
      <div class="preview-block">
        <div id="preview-treble"></div>
        <div class="label">Treble</div>
        <div class="actual-size-note">actual tile size</div>
      </div>
      <div class="preview-block">
        <div id="preview-bass"></div>
        <div class="label">Bass</div>
        <div class="actual-size-note">actual tile size</div>
      </div>
      <div class="preview-block">
        <div id="preview-both"></div>
        <div class="label">Both</div>
        <div class="actual-size-note">actual tile size</div>
      </div>
    </div>
    <div class="preview-row" style="background:white;border:1px dashed #d4cfe8;">
      <div class="preview-block">
        <div id="preview-treble-2x"></div>
        <div class="label">Treble (2× scale, for inspection)</div>
      </div>
      <div class="preview-block">
        <div id="preview-bass-2x"></div>
        <div class="label">Bass (2×)</div>
      </div>
      <div class="preview-block">
        <div id="preview-both-2x"></div>
        <div class="label">Both (2×)</div>
      </div>
    </div>
  </div>

  <div class="controls">
    <fieldset>
      <legend>Glyph system</legend>
      <div class="control-row">
        <label>Font</label>
        <select id="ctl-font" style="grid-column:span 2;font-size:12px;padding:4px;">
          <option value="bravura">Bravura SMuFL (recommended)</option>
          <option value="serif">Serif Unicode</option>
        </select>
      </div>
    </fieldset>

    <fieldset>
      <legend>Staff (single, used in Treble / Bass tiles)</legend>
      <div class="control-row"><label>viewBox W</label><input type="range" id="ctl-vbw" min="60" max="120" value="80"><input type="number" id="ctl-vbw-n" value="80"></div>
      <div class="control-row"><label>viewBox H</label><input type="range" id="ctl-vbh" min="40" max="90" value="60"><input type="number" id="ctl-vbh-n" value="60"></div>
      <div class="control-row"><label>line left x</label><input type="range" id="ctl-lx" min="0" max="20" value="6"><input type="number" id="ctl-lx-n" value="6"></div>
      <div class="control-row"><label>line right x</label><input type="range" id="ctl-rx" min="60" max="120" value="74"><input type="number" id="ctl-rx-n" value="74"></div>
      <div class="control-row"><label>top line y</label><input type="range" id="ctl-ty" min="6" max="30" value="14"><input type="number" id="ctl-ty-n" value="14"></div>
      <div class="control-row"><label>line spacing</label><input type="range" id="ctl-gap" min="6" max="16" value="10" step="0.5"><input type="number" id="ctl-gap-n" value="10" step="0.5"></div>
      <div class="control-row"><label>stroke width</label><input type="range" id="ctl-sw" min="0.5" max="3" value="1.5" step="0.1"><input type="number" id="ctl-sw-n" value="1.5" step="0.1"></div>
    </fieldset>

    <fieldset>
      <legend>Treble clef glyph</legend>
      <div class="control-row"><label>font-size</label><input type="range" id="ctl-tfs" min="20" max="60" value="40" step="0.5"><input type="number" id="ctl-tfs-n" value="40" step="0.5"></div>
      <div class="control-row"><label>x</label><input type="range" id="ctl-tx" min="0" max="40" value="12" step="0.5"><input type="number" id="ctl-tx-n" value="12" step="0.5"></div>
      <div class="control-row"><label>y (baseline)</label><input type="range" id="ctl-ty2" min="30" max="70" value="51.5" step="0.25"><input type="number" id="ctl-ty2-n" value="51.5" step="0.25"></div>
    </fieldset>

    <fieldset>
      <legend>Bass clef glyph</legend>
      <div class="control-row"><label>font-size</label><input type="range" id="ctl-bfs" min="20" max="60" value="40" step="0.5"><input type="number" id="ctl-bfs-n" value="40" step="0.5"></div>
      <div class="control-row"><label>x</label><input type="range" id="ctl-bx" min="0" max="40" value="14" step="0.5"><input type="number" id="ctl-bx-n" value="14" step="0.5"></div>
      <div class="control-row"><label>y (baseline)</label><input type="range" id="ctl-by" min="20" max="60" value="47.75" step="0.25"><input type="number" id="ctl-by-n" value="47.75" step="0.25"></div>
    </fieldset>

    <fieldset>
      <legend>"Both" tile — extra params</legend>
      <div class="control-row"><label>top line y</label><input type="range" id="ctl-bothTopY" min="2" max="20" value="8"><input type="number" id="ctl-bothTopY-n" value="8"></div>
      <div class="control-row"><label>treble→bass gap</label><input type="range" id="ctl-bothGap" min="2" max="20" value="8"><input type="number" id="ctl-bothGap-n" value="8"></div>
      <div class="control-row"><label>line spacing</label><input type="range" id="ctl-bothLg" min="3" max="10" value="6" step="0.25"><input type="number" id="ctl-bothLg-n" value="6" step="0.25"></div>
      <div class="control-row"><label>line stroke</label><input type="range" id="ctl-bothSw" min="0.5" max="2.5" value="1.2" step="0.1"><input type="number" id="ctl-bothSw-n" value="1.2" step="0.1"></div>
      <div class="control-row"><label>treble fs</label><input type="range" id="ctl-bothTfs" min="14" max="36" value="24" step="0.5"><input type="number" id="ctl-bothTfs-n" value="24" step="0.5"></div>
      <div class="control-row"><label>treble x</label><input type="range" id="ctl-bothTx" min="0" max="30" value="10" step="0.5"><input type="number" id="ctl-bothTx-n" value="10" step="0.5"></div>
      <div class="control-row"><label>treble y</label><input type="range" id="ctl-bothTy" min="10" max="50" value="30.5" step="0.25"><input type="number" id="ctl-bothTy-n" value="30.5" step="0.25"></div>
      <div class="control-row"><label>bass fs</label><input type="range" id="ctl-bothBfs" min="14" max="36" value="24" step="0.5"><input type="number" id="ctl-bothBfs-n" value="24" step="0.5"></div>
      <div class="control-row"><label>bass x</label><input type="range" id="ctl-bothBx" min="0" max="30" value="10" step="0.5"><input type="number" id="ctl-bothBx-n" value="10" step="0.5"></div>
      <div class="control-row"><label>bass y</label><input type="range" id="ctl-bothBy" min="30" max="70" value="54.25" step="0.25"><input type="number" id="ctl-bothBy-n" value="54.25" step="0.25"></div>
    </fieldset>
  </div>
</div>

<h2>3 · Output (copy this into the shared helper)</h2>
<button class="copy-btn" id="copy-btn" onclick="copyOutput()">📋 Copy JS snippet</button>
<div class="output-card" id="output"></div>

