// ============ Render the "current variants" comparison grid ============
function renderCurrent() {
  const container = document.getElementById('current-variants');
  const clefs = ['treble', 'bass', 'both'];
  let html = '';
  for (const clef of clefs) {
    html += `<h3>${clef[0].toUpperCase()+clef.slice(1)} clef &mdash; ${CURRENT_VARIANTS[clef].length} variants across ${CURRENT_VARIANTS[clef].reduce((n,v)=>n+v.modules.length,0)} modules</h3>`;
    html += '<div class="variant-grid">';
    CURRENT_VARIANTS[clef].forEach((variant, i) => {
      // Extract the params from the SVG for display
      const textMatches = [...variant.svg.matchAll(/<text[^>]*x="([^"]+)"[^>]*y="([^"]+)"[^>]*font-family="([^"]+)"[^>]*font-size="([^"]+)"[^>]*>([^<]+)<\/text>/g)];
      const paramsLines = textMatches.map((m, j) => {
        const glyph = m[5].length > 1 ? m[5].codePointAt(0).toString(16).toUpperCase() : m[5];
        return `text ${j+1}: font="${m[3]}" size=${m[4]} x=${m[1]} y=${m[2]} glyph="${glyph}"`;
      }).join('\n');
      // 2x by wrapping the svg in a container that scales it
      const svg2x = variant.svg.replace(/<svg ([^>]*)>/, '<svg $1 style="width:160px;height:120px;">');
      const svg1x = variant.svg.replace(/<svg ([^>]*)>/, '<svg $1 style="width:80px;height:60px;">');
      html += `<div class="variant-card">
        <h4>Variant ${i+1}<span class="badge">${variant.modules.length} modules</span></h4>
        <div class="renders">
          <div class="render-block">${svg1x}<div class="label">actual (80×60)</div></div>
          <div class="render-block">${svg2x}<div class="label">2× scale</div></div>
        </div>
        <div class="modules-list">${variant.modules.join(', ')}</div>
        <div class="params">${paramsLines}</div>
      </div>`;
    });
    html += '</div>';
  }
  container.innerHTML = html;
}

// ============ Build the canonical tile SVG from current control values ============
function readCtl(id, isFloat) {
  const v = document.getElementById('ctl-' + id).value;
  return isFloat ? parseFloat(v) : parseInt(v, 10);
}
function getConfig() {
  return {
    font: document.getElementById('ctl-font').value,
    vbw: readCtl('vbw'), vbh: readCtl('vbh'),
    lx: readCtl('lx'), rx: readCtl('rx'),
    ty: readCtl('ty'), gap: readCtl('gap', true),
    sw: readCtl('sw', true),
    treble: { fs: readCtl('tfs', true), x: readCtl('tx', true), y: readCtl('ty2', true) },
    bass:   { fs: readCtl('bfs', true), x: readCtl('bx', true), y: readCtl('by', true) },
    both: {
      topY: readCtl('bothTopY'), gap: readCtl('bothGap'),
      lineGap: readCtl('bothLg', true), sw: readCtl('bothSw', true),
      treble: { fs: readCtl('bothTfs', true), x: readCtl('bothTx', true), y: readCtl('bothTy', true) },
      bass:   { fs: readCtl('bothBfs', true), x: readCtl('bothBx', true), y: readCtl('bothBy', true) },
    }
  };
}
function glyphForFont(font, kind) {
  if (font === 'bravura') return kind === 'treble' ? '&#xE050;' : '&#xE062;';
  return kind === 'treble' ? '𝄞' : '𝄢';
}
function fontFamilyAttr(font) { return font === 'bravura' ? 'Bravura Text' : 'serif'; }

function buildSingleClefTile(cfg, kind) {
  const ff = fontFamilyAttr(cfg.font);
  const g = glyphForFont(cfg.font, kind);
  const k = kind === 'treble' ? cfg.treble : cfg.bass;
  let lines = '';
  for (let i = 0; i < 5; i++) {
    const y = cfg.ty + i * cfg.gap;
    lines += `<line x1="${cfg.lx}" y1="${y}" x2="${cfg.rx}" y2="${y}"/>`;
  }
  return `<svg class="tile-clef" viewBox="0 0 ${cfg.vbw} ${cfg.vbh}" xmlns="http://www.w3.org/2000/svg">
    <g class="staff-line" stroke="#2A2A3E" stroke-width="${cfg.sw}" fill="none">${lines}</g>
    <text class="clef" x="${k.x}" y="${k.y}" font-family="${ff}" font-size="${k.fs}" fill="#2A2A3E">${g}</text>
  </svg>`;
}
function buildBothClefTile(cfg) {
  const ff = fontFamilyAttr(cfg.font);
  const t = glyphForFont(cfg.font, 'treble');
  const b = glyphForFont(cfg.font, 'bass');
  const B = cfg.both;
  let lines = '';
  // Treble staff: 5 lines from topY
  for (let i = 0; i < 5; i++) {
    const y = B.topY + i * B.lineGap;
    lines += `<line x1="${cfg.lx}" y1="${y}" x2="${cfg.rx}" y2="${y}"/>`;
  }
  // Bass staff: 5 lines starting topY + 4*lineGap + gap
  const bassTop = B.topY + 4 * B.lineGap + B.gap;
  for (let i = 0; i < 5; i++) {
    const y = bassTop + i * B.lineGap;
    lines += `<line x1="${cfg.lx}" y1="${y}" x2="${cfg.rx}" y2="${y}"/>`;
  }
  return `<svg class="tile-clef" viewBox="0 0 ${cfg.vbw} ${cfg.vbh}" xmlns="http://www.w3.org/2000/svg">
    <g class="staff-line" stroke="#2A2A3E" stroke-width="${B.sw}" fill="none">${lines}</g>
    <text class="clef" x="${B.treble.x}" y="${B.treble.y}" font-family="${ff}" font-size="${B.treble.fs}" fill="#2A2A3E">${t}</text>
    <text class="clef" x="${B.bass.x}" y="${B.bass.y}" font-family="${ff}" font-size="${B.bass.fs}" fill="#2A2A3E">${b}</text>
  </svg>`;
}

function renderPreview() {
  const cfg = getConfig();
  const t = buildSingleClefTile(cfg, 'treble');
  const b = buildSingleClefTile(cfg, 'bass');
  const bb = buildBothClefTile(cfg);
  // 1x: 80x60
  const set1 = svg => svg.replace(/<svg ([^>]*)>/, `<svg $1 style="width:${cfg.vbw}px;height:${cfg.vbh}px;">`);
  // 2x: scaled
  const set2 = svg => svg.replace(/<svg ([^>]*)>/, `<svg $1 style="width:${cfg.vbw*2}px;height:${cfg.vbh*2}px;">`);
  document.getElementById('preview-treble').innerHTML = set1(t);
  document.getElementById('preview-bass').innerHTML = set1(b);
  document.getElementById('preview-both').innerHTML = set1(bb);
  document.getElementById('preview-treble-2x').innerHTML = set2(t);
  document.getElementById('preview-bass-2x').innerHTML = set2(b);
  document.getElementById('preview-both-2x').innerHTML = set2(bb);
  renderOutput(cfg);
}

function renderOutput(cfg) {
  // Build a clean JS helper snippet that, given a clef, returns the SVG markup.
  const ff = fontFamilyAttr(cfg.font);
  const trebleGlyph = cfg.font === 'bravura' ? "'\\uE050'" : "'\\u{1D11E}'";
  const bassGlyph   = cfg.font === 'bravura' ? "'\\uE062'" : "'\\u{1D122}'";
  const snippet = `// Canonical clef-picker tile renderer. Source of truth for treble/bass/both
// start-screen tiles. Generated by _clef-calibrator.html.
// Place this in qn-ui.js (or similar shared helper); each clef-picker module
// calls QN.ui.clefTile({clef: 'treble'|'bass'|'both'}) instead of inlining its
// own SVG.

(window.QN = window.QN || {}).ui = window.QN.ui || {};
QN.ui.clefTile = function (opts) {
  const clef = opts.clef;  // 'treble' | 'bass' | 'both'
  const VBW = ${cfg.vbw}, VBH = ${cfg.vbh};
  const FF  = ${JSON.stringify(ff)};
  const T   = ${trebleGlyph};
  const B   = ${bassGlyph};

  // Single-staff layout (treble or bass)
  const SINGLE = {
    lx: ${cfg.lx}, rx: ${cfg.rx}, topY: ${cfg.ty}, gap: ${cfg.gap}, sw: ${cfg.sw},
    treble: { fs: ${cfg.treble.fs}, x: ${cfg.treble.x}, y: ${cfg.treble.y} },
    bass:   { fs: ${cfg.bass.fs},   x: ${cfg.bass.x},   y: ${cfg.bass.y} }
  };

  // Two-staff "both" layout
  const BOTH = {
    topY: ${cfg.both.topY}, gap: ${cfg.both.gap},
    lineGap: ${cfg.both.lineGap}, sw: ${cfg.both.sw},
    treble: { fs: ${cfg.both.treble.fs}, x: ${cfg.both.treble.x}, y: ${cfg.both.treble.y} },
    bass:   { fs: ${cfg.both.bass.fs},   x: ${cfg.both.bass.x},   y: ${cfg.both.bass.y} }
  };

  function lines(left, right, ys, sw) {
    return '<g class="staff-line" stroke="#2A2A3E" stroke-width="' + sw + '" fill="none">' +
      ys.map(y => '<line x1="' + left + '" y1="' + y + '" x2="' + right + '" y2="' + y + '"/>').join('') +
    '</g>';
  }
  function glyph(g, k) {
    return '<text class="clef" x="' + k.x + '" y="' + k.y + '" font-family="' + FF + '" font-size="' + k.fs + '" fill="#2A2A3E">' + g + '</text>';
  }

  if (clef === 'treble' || clef === 'bass') {
    const ys = [0,1,2,3,4].map(i => SINGLE.topY + i * SINGLE.gap);
    const g = clef === 'treble' ? glyph(T, SINGLE.treble) : glyph(B, SINGLE.bass);
    return '<svg class="tile-clef" viewBox="0 0 ' + VBW + ' ' + VBH + '" xmlns="http://www.w3.org/2000/svg">' +
      lines(SINGLE.lx, SINGLE.rx, ys, SINGLE.sw) + g + '</svg>';
  }
  // both
  const tYs = [0,1,2,3,4].map(i => BOTH.topY + i * BOTH.lineGap);
  const bassTop = BOTH.topY + 4 * BOTH.lineGap + BOTH.gap;
  const bYs = [0,1,2,3,4].map(i => bassTop + i * BOTH.lineGap);
  return '<svg class="tile-clef" viewBox="0 0 ' + VBW + ' ' + VBH + '" xmlns="http://www.w3.org/2000/svg">' +
    lines(SINGLE.lx, SINGLE.rx, tYs.concat(bYs), BOTH.sw) +
    glyph(T, BOTH.treble) + glyph(B, BOTH.bass) +
  '</svg>';
};`;
  // Syntax highlight (very lightweight)
  const escaped = snippet.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  document.getElementById('output').innerHTML = escaped
    .replace(/\b(const|var|let|function|return|if|new)\b/g, '<span class="key">$1</span>')
    .replace(/\b(\d+\.?\d*)\b/g, '<span class="val">$1</span>');
}

function copyOutput() {
  const txt = document.getElementById('output').textContent;
  navigator.clipboard.writeText(txt).then(() => {
    const btn = document.getElementById('copy-btn');
    btn.classList.add('copied');
    btn.textContent = '✓ Copied!';
    setTimeout(() => { btn.classList.remove('copied'); btn.textContent = '📋 Copy JS snippet'; }, 1400);
  });
}

