    bothBfs: 20, bothBx: 10, bothBy: 51.875,
  },
};
function loadPreset(name) {
  const p = PRESETS[name];
  if (!p) return;
  document.getElementById('ctl-font').value = p.font;
  Object.keys(p).forEach(k => {
    if (k === 'font') return;
    const slider = document.getElementById('ctl-' + k);
    const num = document.getElementById('ctl-' + k + '-n');
    if (slider) slider.value = p[k];
    if (num) num.value = p[k];
  });
  renderPreview();
}

// Wire up slider ↔ number-input two-way binding
function wireControls() {
  document.querySelectorAll('.controls input[type=range]').forEach(slider => {
    const num = document.getElementById(slider.id + '-n');
    slider.addEventListener('input', () => {
      if (num) num.value = slider.value;
      renderPreview();
    });
    if (num) {
      num.addEventListener('input', () => {
        slider.value = num.value;
        renderPreview();
      });
    }
  });
  document.getElementById('ctl-font').addEventListener('change', renderPreview);
}

document.addEventListener('DOMContentLoaded', () => {
  renderCurrent();
  wireControls();
  renderPreview();
});
