<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>QuizNote — Time-Sig Digit Weight Calibrator</title>
<style>
  :root { --ink:#2A2A3E; --cream:#FBF6E9; }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 24px;
    font-family: -apple-system, system-ui, sans-serif;
    background: var(--cream); color: var(--ink);
  }
  h1 { font-size: 20px; margin: 0 0 4px; }
  p.lead { margin: 0 0 20px; color: #555; max-width: 720px; line-height: 1.5; }
  .controls {
    background: #fff; border: 2px solid var(--ink); border-radius: 14px;
    padding: 18px 20px; margin-bottom: 24px; max-width: 720px;
  }
  .row { display: flex; align-items: center; gap: 16px; margin: 10px 0; }
  .row label { width: 200px; font-size: 14px; font-weight: 600; }
  .row input[type=range] { flex: 1; }
  .row .val { width: 70px; text-align: right; font-variant-numeric: tabular-nums; font-weight: 700; }
  .readout {
    margin-top: 14px; background: var(--ink); color: #fff;
    border-radius: 10px; padding: 12px 14px;
    font-family: ui-monospace, Menlo, monospace; font-size: 13px; line-height: 1.6;
    white-space: pre;
  }
  .grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; max-width: 1100px; }
  .cell {
    background: #fff; border: 2px solid var(--ink); border-radius: 14px;
    padding: 10px; text-align: center;
  }
  .cell .cap { font-size: 12px; color: #888; margin-top: 4px; }
  .sigs { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; max-width: 1100px; margin-top: 20px; }
  svg { display: block; width: 100%; height: auto; }
  .note { font-size: 13px; color: #555; max-width: 720px; margin: 22px 0 8px; line-height: 1.5; }
</style>
</head>
<body>
  <h1>Time-Signature Digit Weight Calibrator</h1>
  <p class="lead">
    The digits are filled vector paths. The <b>weight</b> slider uses SVG's
    feMorphology filter to erode (thinner) or dilate (bolder) the glyph shapes
    uniformly — true bidirectional weight, geometry-exact, works over staff
    lines. Dial until it reads right, then copy the values from the dark box
    into chat. Top row shows each glyph in its box; bottom shows real time
    signatures on a staff (the actual render context).
  </p>

  <div class="controls">
    <div class="row">
      <label>weight (− thinner, + bolder)</label>
      <input id="weight" type="range" min="-3" max="3" step="0.25" value="0">
      <span class="val" id="weight-val">0.00</span>
    </div>
    <div class="row">
      <label>glyph height (× lineGap)</label>
      <input id="glyphH" type="range" min="1.5" max="2.6" step="0.05" value="2.0">
      <span class="val" id="glyphH-val">2.00</span>
    </div>
    <div class="readout" id="readout"></div>
  </div>

  <div class="grid" id="digits"></div>
  <div class="note">Time signatures on a real staff (treble, lineGap 20):</div>
  <div class="sigs" id="sigs"></div>

<script>
  const DIGIT_W = 100, DIGIT_H = 140;
  const DIGIT_PATHS = {
    '0': 'M50 4 C76 4 92 30 92 70 C92 110 76 136 50 136 C24 136 8 110 8 70 C8 30 24 4 50 4 Z M50 30 C38 30 32 48 32 70 C32 92 38 110 50 110 C62 110 68 92 68 70 C68 48 62 30 50 30 Z',
    '1': 'M58 4 L58 136 L34 136 L34 36 L14 46 L14 22 L40 4 Z',
    '2': 'M14 40 C14 14 34 4 52 4 C74 4 90 18 90 42 C90 60 78 74 60 90 L44 104 L92 104 L92 136 L12 136 L12 112 L52 74 C62 64 66 56 66 46 C66 36 60 30 50 30 C40 30 36 38 36 48 L36 52 L14 52 Z',
    '3': 'M14 38 C16 14 36 4 54 4 C76 4 90 16 90 38 C90 52 82 62 70 66 C84 70 92 82 92 98 C92 122 74 136 52 136 C30 136 12 124 12 98 L12 96 L36 96 L36 100 C36 108 42 114 52 114 C62 114 68 108 68 98 C68 88 60 82 48 82 L40 82 L40 60 L48 60 C58 60 66 54 66 44 C66 36 60 30 52 30 C42 30 38 36 38 46 L14 46 Z',
    '4': 'M62 4 L92 4 L92 88 L106 88 L106 110 L92 110 L92 136 L68 136 L68 110 L8 110 L8 86 Z M68 88 L68 38 L36 88 Z',
    '5': 'M20 4 L88 4 L88 28 L42 28 L40 54 C46 50 54 48 62 48 C82 48 94 64 94 92 C94 120 76 136 52 136 C30 136 12 122 12 98 L12 96 L36 96 L36 98 C36 108 42 114 52 114 C62 114 70 106 70 92 C70 78 62 70 50 70 C42 70 36 74 32 80 L12 76 Z',
    '6': 'M52 4 C72 4 86 14 88 32 L64 36 C62 32 58 28 52 28 C40 28 34 42 33 64 C40 56 50 52 60 52 C80 52 94 68 94 92 C94 118 76 136 52 136 C26 136 10 116 10 78 C10 32 28 4 52 4 Z M52 74 C42 74 34 82 34 94 C34 106 42 114 52 114 C62 114 70 106 70 94 C70 82 62 74 52 74 Z',
    '7': 'M12 4 L92 4 L92 26 L52 136 L26 136 L66 28 L12 28 Z',
    '8': 'M50 4 C72 4 88 16 88 36 C88 50 80 60 68 64 C82 68 92 80 92 96 C92 120 74 136 50 136 C26 136 8 120 8 96 C8 80 18 68 32 64 C20 60 12 50 12 36 C12 16 28 4 50 4 Z M50 26 C42 26 36 32 36 40 C36 48 42 54 50 54 C58 54 64 48 64 40 C64 32 58 26 50 26 Z M50 76 C40 76 32 84 32 94 C32 106 40 112 50 112 C60 112 68 106 68 94 C68 84 60 76 50 76 Z',
    '9': 'M48 4 C74 4 90 24 90 62 C90 108 72 136 48 136 C28 136 14 126 12 108 L36 104 C38 108 42 112 48 112 C60 112 66 98 67 76 C60 84 50 88 40 88 C20 88 6 72 6 48 C6 22 24 4 48 4 Z M48 26 C38 26 30 34 30 46 C30 58 38 66 48 66 C58 66 66 58 66 46 C66 34 58 26 48 26 Z',
  };
  const INK = '#2A2A3E';

  const P = { weight: 0, glyphH: 2.0 };

  // feMorphology erode (negative weight = thinner) / dilate (positive = bolder).
  // Radius is in glyph-box units; we expose one signed "weight" slider.
  function filterDefs() {
    const w = P.weight;
    if (w === 0) return '';
    const op = w < 0 ? 'erode' : 'dilate';
    const r = Math.abs(w);
    return `<defs><filter id="wt" x="-20%" y="-20%" width="140%" height="140%">`
      + `<feMorphology operator="${op}" radius="${r}"/></filter></defs>`;
  }

  function glyph(d, tx, ty, scale) {
    const filt = P.weight !== 0 ? ` filter="url(#wt)"` : '';
    return `<g transform="translate(${tx} ${ty}) scale(${scale})">`
      + `<path d="${DIGIT_PATHS[d]}" fill="${INK}" fill-rule="evenodd"${filt}/></g>`;
  }

  function renderDigits() {
    const box = document.getElementById('digits');
    box.innerHTML = '';
    for (let d = 0; d <= 9; d++) {
      const scale = 1;
      const svg = `<svg viewBox="-10 -10 120 160">`
        + filterDefs()
        + `<rect x="0" y="0" width="100" height="140" fill="none" stroke="#ddd"/>`
        + glyph(String(d), 0, 0, 1)
        + `</svg>`;
      const cell = document.createElement('div');
      cell.className = 'cell';
      cell.innerHTML = svg + `<div class="cap">${d}</div>`;
      box.appendChild(cell);
    }
  }

  function buildStaffLines(bottomY, lineGap, width) {
    let s = '';
    for (let i = 0; i < 5; i++) {
      const y = bottomY - i * lineGap;
      s += `<line x1="8" y1="${y}" x2="${width-8}" y2="${y}" stroke="${INK}" stroke-width="2" stroke-linecap="round"/>`;
    }
    return s;
  }

  function timeSig(top, bottom, x, bottomY, lineGap) {
    const glyphH = lineGap * P.glyphH;
    const scale = glyphH / DIGIT_H;
    const glyphW = DIGIT_W * scale;
    const gap = glyphW * 0.04;
    const midY = bottomY - 2 * lineGap;
    const topCenter = midY - lineGap * 1.02;
    const botCenter = midY + lineGap * 1.02;
    function stack(numStr, centerY) {
      const n = numStr.length;
      const totalW = n * glyphW + (n-1)*gap;
      const left = x - totalW/2;
      let out = '';
      for (let i = 0; i < n; i++) {
        const lx = left + i*(glyphW+gap);
        out += glyph(numStr[i], lx, centerY - glyphH/2, scale);
      }
      return out;
    }
    return stack(String(top), topCenter) + stack(String(bottom), botCenter);
  }

  function renderSigs() {
    const box = document.getElementById('sigs');
    box.innerHTML = '';
    const pairs = [[2,4],[3,4],[4,4],[6,8],[12,8]];
    const lineGap = 20, bottomY = 130, width = 200;
    pairs.forEach(([t,b]) => {
      const svg = `<svg viewBox="0 0 ${width} 170">`
        + filterDefs()
        + buildStaffLines(bottomY, lineGap, width)
        + timeSig(t, b, 120, bottomY, lineGap)
        + `</svg>`;
      const cell = document.createElement('div');
      cell.className = 'cell';
      cell.innerHTML = svg + `<div class="cap">${t}/${b}</div>`;
      box.appendChild(cell);
    });
  }

  function readout() {
    document.getElementById('readout').textContent =
      `// paste these back to me:\n`
      + `weight = ${P.weight.toFixed(2)}   (feMorphology radius; − erode/thinner, + dilate/bolder)\n`
      + `glyphH = ${P.glyphH.toFixed(2)}   (× lineGap)`;
  }

  function renderAll() { renderDigits(); renderSigs(); readout(); }

  ['weight','glyphH'].forEach(id => {
    const sl = document.getElementById(id);
    const v = document.getElementById(id+'-val');
    sl.addEventListener('input', () => {
      P[id] = parseFloat(sl.value);
      v.textContent = P[id].toFixed(2);
      renderAll();
    });
  });

  renderAll();
</script>
</body>
</html>
